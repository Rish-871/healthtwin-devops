FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source and all ML artifacts
COPY api.py ./
COPY health_dataset_1000_total.csv ./
COPY health_model.h5 ./
COPY health_preprocessor.pkl ./

EXPOSE 5000

CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-5000} --workers 1 --timeout 120 api:app"]
